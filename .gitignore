# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Dependencies - NEVER commit node_modules
node_modules/
**/node_modules/

# Lock files - package-lock.json SHOULD be committed (for consistent installs)
# yarn.lock and pnpm-lock.yaml can be committed if using those package managers
# Uncomment if you want to exclude lock files:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Environment
.env
.env.local
.env.*.local

# Credentials and Secrets - NEVER commit these!
google-service-account.json
*credentials*.json
*token*.json
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.secret

# Exported/Backup files - Large exported HTML files with dependencies
assets/raw/
**/*_files/
*.html_files/

# Temporary and cache files
*.cache
.cache/
tmp/
temp/

# Temporary video files (will be uploaded to YouTube)
assets/videos/*.mp4
assets/videos/*.mov
assets/videos/*.avi
assets/videos/*.mkv
